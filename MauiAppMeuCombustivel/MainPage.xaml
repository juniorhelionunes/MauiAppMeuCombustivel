<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppMeuCombustivel.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="15">

            <Image
                Source="dotnet_bot.png"
                HeightRequest="150"
                Aspect="AspectFit"
                SemanticProperties.Description="Aplicativo de cálculo de combustível" />

            <Label
                Text="Calculadora de Combustível"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label Text="Marca do Veículo:" />
            <Entry
                x:Name="txt_marca"
                Placeholder="Ex.: Chevrolet" />

            <Label Text="Modelo do Veículo:" />
            <Entry
                x:Name="txt_modelo"
                Placeholder="Ex.: Onix" />

            <Label Text="Preço do Etanol:" />
            <Entry
                x:Name="txt_etanol"
                Placeholder="R$ 0,00"
                Keyboard="Numeric" />

            <Label Text="Preço da Gasolina:" />
            <Entry
                x:Name="txt_gasolina"
                Placeholder="R$ 0,00"
                Keyboard="Numeric" />

            <Button
                Text="Qual compensa mais?"
                Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

